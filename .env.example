# Copy this file to `.env` and fill in your real key. `.env` is gitignored.

# A single OpenRouter key covers Claude, GPT-4o, and Perplexity — all LLM
# calls in this project route through https://openrouter.ai.
# Generate a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — OpenRouter leaderboard attribution. Defaults shown below.
# OPENROUTER_REFERER=https://github.com/CindaX/geo_toolkit
# OPENROUTER_APP_NAME=geo_toolkit
