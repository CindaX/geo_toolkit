# Streamlit Cloud secrets template — copy this to .streamlit/secrets.toml
# for local testing (the real file is gitignored).
#
# On Streamlit Cloud, set these in the deployed app's "Settings → Secrets"
# section in the same TOML format.

# Required: OpenRouter API key. Covers Claude (Sonnet/Opus/Haiku), GPT-4o,
# and Perplexity through one unified gateway. Get a key at
# https://openrouter.ai/keys — set a monthly spending limit before deploying.
OPENROUTER_API_KEY = "sk-or-v1-xxx-replace-with-real-key"

# Optional: HTTP-Referer + X-Title headers OpenRouter uses for its public
# leaderboard. Defaults are fine — only override if rebranding the app.
# OPENROUTER_REFERER = "https://github.com/CindaX/geo_toolkit"
# OPENROUTER_APP_NAME = "geo_toolkit"
