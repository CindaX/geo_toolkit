# Streamlit Cloud secrets template — copy this to .streamlit/secrets.toml
# for local testing (the real file is gitignored).
#
# On Streamlit Cloud, set these in the deployed app's "Settings → Secrets"
# section in the same TOML format.

# Required: OpenRouter API key. Covers Claude (Sonnet/Opus/Haiku), GPT-4o,
# and Perplexity through one unified gateway. Get a key at
# https://openrouter.ai/keys — set a monthly spending limit before deploying.
OPENROUTER_API_KEY = "sk-or-v1-xxx-replace-with-real-key"

# Optional: HTTP-Referer + X-Title headers OpenRouter uses for its public
# leaderboard. Defaults are fine — only override if rebranding the app.
# OPENROUTER_REFERER = "https://github.com/CindaX/geo_toolkit"
# OPENROUTER_APP_NAME = "geo_toolkit"

# Supabase — persistent storage for captured emails + audit results.
# Survives Streamlit Cloud restarts and the session loss that happens when
# users return from Stripe checkout. Free tier (500 MB) is plenty for MVP.
# Get credentials from https://supabase.com/dashboard → Settings → API.
# If unset, the app falls back to ephemeral /tmp CSV storage.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-key-here"

# Stripe — secret key for verifying Checkout Session payment_status on
# the post-payment redirect. Accepts sk_test_... or sk_live_...; the app
# does not parse the prefix so test/live switch is a secrets-only change.
# Get key from https://dashboard.stripe.com/apikeys (Restricted Key with
# at least "Checkout Sessions: Read" scope is sufficient).
# If unset, no purchase will ever be verified — app stays in free-only mode.
STRIPE_SECRET_KEY = "sk_test_or_live_..."
